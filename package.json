{
  "name": "devboxes",
  "version": "0.10.0",
  "private": true,
  "description": "devboxes CLI: discover and invoke application commands, authenticate, run execution capacity, and serve stdio MCP.",
  "homepage": "https://github.com/firatoezcan/devboxes-cli#readme",
  "bugs": "https://github.com/firatoezcan/devboxes-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatoezcan/devboxes-cli.git"
  },
  "type": "module",
  "dependencies": {
    "@better-fetch/fetch": "1.3.3",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.7.0",
    "better-auth": "1.7.13",
    "commander": "^14.0.3",
    "dockerode": "5.0.1",
    "effect": "4.0.1",
    "elysia": "2.0.0-rc.0",
    "hono": "4.12.15",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.6",
    "tar-stream": "3.1.7",
    "tough-cookie": "6.0.1",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/tar-stream": "3.1.5",
    "bun-types": "1.4.4",
    "drizzle-orm": "1.0.0-rc.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "exports": {
    "./protocol/*": "./src/protocol/*.ts",
    "./provider-connect/*": "./src/provider-connect/*.ts"
  },
  "scripts": {
    "build": "bun scripts/build-cli-binaries.ts",
    "build:smoke": "bun scripts/build-cli-binaries.ts --smoke",
    "devboxes:local": "bun src/cli.ts",
    "test": "bun test --isolate --no-orphans --timeout 60000",
    "test:full": "bun test --isolate --no-orphans --timeout 60000"
  },
  "patchedDependencies": {
    "better-auth@1.7.13": "patches/better-auth.patch",
    "drizzle-kit@1.0.0-rc.5": "patches/drizzle-kit@1.0.0-rc.5.patch"
  }
}
