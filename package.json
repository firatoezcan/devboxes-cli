{
  "name": "devboxes",
  "version": "0.1.0",
  "private": false,
  "description": "Devboxes CLI: connect a terminal, dispatch coding tasks, follow sessions, and serve the same actions as MCP tools.",
  "homepage": "https://github.com/firatoezcan/devboxes-cli#readme",
  "bugs": "https://github.com/firatoezcan/devboxes-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatoezcan/devboxes-cli.git"
  },
  "bin": {
    "devboxes": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "devboxes": "bun src/cli.ts",
    "test": "bun test --isolate --timeout 60000 --changed=origin/dev",
    "test:full": "bun test --isolate --timeout 60000",
    "tslint": "tsgo --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@elysiajs/eden": "^1.4.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-auth": "^1.6.9",
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "typebox": "^1.1.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260425.1",
    "bun-types": "^1.3.14",
    "drizzle-orm": "1.0.0-beta.22",
    "elysia": "^1.4.28"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "pnpm@10.33.2"
}
