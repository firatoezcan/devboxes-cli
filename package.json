{
  "name": "devboxes",
  "version": "0.2.5",
  "private": true,
  "description": "Devboxes CLI: sign in, dispatch coding tasks, follow sessions, run connected machines, and expose MCP tools.",
  "homepage": "https://github.com/firatoezcan/devboxes-cli#readme",
  "bugs": "https://github.com/firatoezcan/devboxes-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatoezcan/devboxes-cli.git"
  },
  "type": "module",
  "exports": {
    "./protocol/*": "./src/protocol/*.ts",
    "./provider-connect/*": "./src/provider-connect/*.ts"
  },
  "scripts": {
    "build": "bun scripts/build-cli-binaries.ts",
    "build:smoke": "bun scripts/build-cli-binaries.ts --smoke",
    "devboxes:local": "NODE_EXTRA_CA_CERTS=${DEVBOXES_LOCAL_CA_DIR:-$HOME/.local/share/devboxes/ca}/root.crt bun src/cli.ts",
    "test": "node --experimental-strip-types ../../scripts/run-devboxes-cli-tests.ts --task=test --changed=origin/dev",
    "test:full": "node --experimental-strip-types ../../scripts/run-devboxes-cli-tests.ts --task=test:full"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@elysiajs/eden": "^1.4.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "age-encryption": "0.3.0",
    "better-auth": "^1.6.9",
    "commander": "^14.0.3",
    "dockerode": "5.0.1",
    "elysia": "^1.4.28",
    "log-update": "8.0.0",
    "open": "^11.0.0",
    "typebox": "^1.1.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "1.4.0",
    "drizzle-orm": "1.0.0-beta.22",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2"
}
