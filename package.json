{
  "name": "devboxes",
  "version": "0.4.1",
  "private": true,
  "description": "Devboxes CLI: discover and invoke application commands, authenticate, run execution capacity, and serve stdio MCP.",
  "homepage": "https://github.com/firatoezcan/devboxes-cli#readme",
  "bugs": "https://github.com/firatoezcan/devboxes-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatoezcan/devboxes-cli.git"
  },
  "type": "module",
  "dependencies": {
    "@better-fetch/fetch": "1.1.21",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/models": "0.0.43",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.7.0",
    "better-auth": "1.6.9",
    "commander": "^14.0.3",
    "dockerode": "5.0.1",
    "elysia": "^1.4.28",
    "jose": "6.2.2",
    "oauth4webapi": "3.8.6",
    "tough-cookie": "6.0.1",
    "typebox": "^1.1.34",
    "zod": "^4.3.6",
    "@effect/platform-node": "4.0.0-rc.112",
    "@opencode-ai/server": "0.0.0-dev-18687",
    "axios": "1.19.0",
    "effect": "4.0.0-rc.112",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "1.4.0",
    "drizzle-orm": "1.0.0-beta.22",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "optionalDependencies": {
    "@opencode-ai/pty-linux-arm64-gnu": "0.1.13",
    "@opencode-ai/pty-linux-x64-gnu": "0.1.13"
  },
  "exports": {
    "./protocol/*": "./src/protocol/*.ts",
    "./provider-connect/*": "./src/provider-connect/*.ts"
  },
  "scripts": {
    "build": "bun scripts/build-cli-binaries.ts",
    "build:smoke": "bun scripts/build-cli-binaries.ts --smoke",
    "devboxes:local": "bun src/cli.ts",
    "test": "bun test --isolate --no-orphans --timeout 60000",
    "test:full": "bun test --isolate --no-orphans --timeout 60000",
    "build:daemon": "bun run build:daemon:linux-amd64",
    "build:daemon:linux-amd64": "bun build src/daemon/index.ts --compile --sourcemap=external --target=bun-linux-x64-baseline --outfile build/linux-amd64/devboxes-daemon",
    "build:daemon:linux-arm64": "bun build src/daemon/index.ts --compile --sourcemap=external --target=bun-linux-arm64 --outfile build/linux-arm64/devboxes-daemon"
  }
}