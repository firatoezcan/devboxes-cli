{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": false,
    "incremental": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun-types", "node"],
    "noEmit": true,
    // Monorepo-only wiring: maps the type-only #monorepo/* imports and the
    // test harness onto private workspace sources. In the public source
    // mirror these targets do not exist — the shipped runtime never resolves
    // them (all uses are erased `import type` / test-only imports).
    "paths": {
      "@/*": ["../firops-api/src/*"],
      "#monorepo/api": ["../firops-api/src/app.ts"]
    }
  },
  "include": ["src/**/*.ts", "../firops-api/types/**/*.d.ts"]
}
